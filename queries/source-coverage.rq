# Buildings attested by more than one source (common records).
# sourceCount / sourceSet are convenience literals; attestedBy is the graph form.
# SELECT ?building ?label ?sourceSet ?sourceCount
#        (GROUP_CONCAT(DISTINCT ?srcId; separator=" | ") AS ?sources)
