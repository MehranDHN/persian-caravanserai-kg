#   ?building persarch:attestedBy ?src ;
#             persarch:sourceSet ?sourceSet ;
#             persarch:sourceCount ?sourceCount ;
#             rdfs:label ?label .
#   FILTER(LANG(?label) = "en")
#   ?src persarch:sourceId ?srcId .
# }
# GROUP BY ?building ?label ?sourceSet ?sourceCount
# HAVING (COUNT(DISTINCT ?src) >= 2)
# ORDER BY DESC(?sourceCount) ?label

