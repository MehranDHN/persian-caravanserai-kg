#----- 10. Miandasht (1668-027 / Q5705395) multi-court complex -----

:miandasht a persarch:DualCourtCaravanserai , persarch:Caravanserai ,
        bot:Building , crmba:B1_Built_Work ;
    rdfs:label "Miandasht Caravanserai"@en , "کاروانسراهای میاندشت"@fa ;
    skos:exactMatch wd:Q5705395 ;
    persarch:unescoComponentId "1668-027" ;
    persarch:isUnescoComponent true ;
    persarch:nationalHeritageNumber "1439" ;
    persarch:province "Semnan"@en ;
