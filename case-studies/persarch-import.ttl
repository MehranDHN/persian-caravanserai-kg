@prefix :         <https://w3id.org/persian-caravanserai-kg#> .
@prefix persarch: <https://w3id.org/persian-architecture#> .
@prefix bot:      <https://w3id.org/bot#> .
@prefix crm:      <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmba:    <http://www.cidoc-crm.org/extensions/crmba/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix geo:      <http://www.opengis.net/ont/geosparql#> .
@prefix wd:       <http://www.wikidata.org/entity/> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .

#################################################################
# Ten persarch-aligned case studies.
# BOT = present topology. CRM = who / when / of what.
# Same individuals may appear in data/unesco-1668.ttl; this file adds depth.
#################################################################

#----- 1. Ribat-e Sharaf (1668-005 / Q2577338) dual-court Seljuk -----

:ribat_sharaf a persarch:DualCourtCaravanserai , persarch:Caravanserai ,
        bot:Building , crmba:B1_Built_Work ;
    rdfs:label "Ribat-e Sharaf"@en , "رباط شرف"@fa ;
    skos:exactMatch wd:Q2577338 ;
    persarch:unescoComponentId "1668-005" ;
    persarch:isUnescoComponent true ;
    persarch:nationalHeritageNumber "359" ;
    crm:P2_has_type persarch:type_caravanserai , persarch:type_four_iwan_plan ,
        persarch:style_seljuk , persarch:style_great_seljuk ;
    crm:P45_consists_of persarch:mat_brick ;
    geo:asWKT "POINT(60.655161 36.266569)"^^geo:wktLiteral ;
    crm:P53_has_former_or_current_location :place_ribat_sharaf ;
    bot:hasStorey :ribat_sharaf_ground ;
    bot:containsZone :ribat_sharaf_public_zone , :ribat_sharaf_royal_zone ,
        :ribat_sharaf_axis ;
    persarch:hasIiifManifest <https://w3id.org/persian-caravanserai-kg/iiif/ribat-sharaf/manifest.json> ;
    dcterms:source <https://www.archnet.org/sites/3873> ;
    rdfs:seeAlso <https://w3id.org/persian-architecture/data/ribat-sharaf#Ribat_i_Sharaf> .

:place_ribat_sharaf a crm:E53_Place ;
    rdfs:label "Nishapur–Sarakhs road, Sarakhs County"@en .

:ribat_sharaf_ground a bot:Storey ;
    rdfs:label "Ground storey – Ribat-e Sharaf"@en ;
    bot:hasSpace :ribat_sharaf_outer_court , :ribat_sharaf_inner_court ,
        :ribat_sharaf_corridor , :ribat_sharaf_entrance_iwan ,
        :ribat_sharaf_stables , :ribat_sharaf_outer_mosque , :ribat_sharaf_inner_mosque .

:ribat_sharaf_public_zone a persarch:PublicServiceZone , bot:Zone ;
    rdfs:label "Public-service zone"@en ;
    bot:containsZone :ribat_sharaf_outer_court , :ribat_sharaf_stables ,
        :ribat_sharaf_entrance_iwan , :ribat_sharaf_outer_mosque .

:ribat_sharaf_royal_zone a persarch:RoyalSuiteZone , bot:Zone ;
    rdfs:label "Royal-suite zone"@en ;
    bot:containsZone :ribat_sharaf_inner_court , :ribat_sharaf_inner_mosque .

:ribat_sharaf_outer_court a persarch:Sahn , bot:Space ;
    rdfs:label "Outer courtyard (public / stabling)"@en ;
    rdfs:comment "Rectangle ≈ 32.4 × 16.5 m."@en ;
    bot:adjacentZone :ribat_sharaf_entrance_iwan , :ribat_sharaf_corridor ,
        :ribat_sharaf_stables , :ribat_sharaf_outer_mosque ;
    bot:containsElement :ribat_sharaf_outer_well .

:ribat_sharaf_inner_court a persarch:Sahn , bot:Space ;
    rdfs:label "Inner courtyard (royal)"@en ;
    rdfs:comment "Square ≈ 31.8 × 31.3 m."@en ;
    bot:adjacentZone :ribat_sharaf_corridor , :ribat_sharaf_inner_mosque ;
    bot:containsElement :ribat_sharaf_inner_howz .

:ribat_sharaf_corridor a bot:Space ;
    rdfs:label "Connecting iwan between the two courts"@en ;
    bot:adjacentZone :ribat_sharaf_outer_court , :ribat_sharaf_inner_court ;
    bot:intersectsZone :ribat_sharaf_public_zone , :ribat_sharaf_royal_zone .

:ribat_sharaf_axis a persarch:ProcessionalAxis , bot:Zone ;
    rdfs:label "Processional axis from pishtaq to inner mosque"@en ;
    bot:intersectsZone :ribat_sharaf_entrance_iwan , :ribat_sharaf_outer_court ,
        :ribat_sharaf_corridor , :ribat_sharaf_inner_court , :ribat_sharaf_inner_mosque .

:ribat_sharaf_entrance_iwan a persarch:Iwan , bot:Space ;
    rdfs:label "South-east entrance iwan"@en ;
    bot:adjacentZone :ribat_sharaf_outer_court ;
    bot:adjacentElement :ribat_sharaf_pishtaq .

:ribat_sharaf_stables a persarch:Stable , bot:Space ;
    rdfs:label "South-west stables"@en ;
    bot:adjacentZone :ribat_sharaf_outer_court .

:ribat_sharaf_outer_mosque a persarch:MosqueSpace , bot:Space ;
    rdfs:label "Mosque of the outer court"@en ;
    bot:adjacentZone :ribat_sharaf_outer_court ;
    bot:adjacentElement :ribat_sharaf_outer_mihrab .

:ribat_sharaf_inner_mosque a persarch:MosqueSpace , bot:Space ;
    rdfs:label "Mosque of the inner court"@en ;
    bot:adjacentZone :ribat_sharaf_inner_court .

:ribat_sharaf_outer_well a persarch:Well , bot:Element ;
    rdfs:label "Well in the outer courtyard"@en .
:ribat_sharaf_inner_howz a persarch:Howz , bot:Element ;
    rdfs:label "Howz in the inner courtyard"@en .
:ribat_sharaf_pishtaq a persarch:Pishtaq , bot:Element ;
    rdfs:label "South-east entrance pishtaq"@en ;
    bot:hasSubElement :ribat_sharaf_pishtaq_inscription .
:ribat_sharaf_pishtaq_inscription a persarch:Inscription , crm:E34_Inscription , bot:Element ;
    rdfs:label "Foundation / restoration inscription"@en ;
    persarch:hasScriptStyle persarch:script_kufic .
:ribat_sharaf_outer_mihrab a persarch:Mihrab , bot:Element ;
    rdfs:label "Mihrab of the outer mosque"@en .

:actor_sharaf_al_din a crm:E21_Person ;
    rdfs:label "Sharaf al-Din Abu Tahir"@en , "شرف‌الدین ابو طاهر"@fa ;
    crm:P2_has_type persarch:role_patron .
:actor_katib_ali a crm:E21_Person ;
    rdfs:label "Katib Ali al-Mansur Asad b. Muhammad al-Sarahsi"@en ;
    crm:P2_has_type persarch:role_architect .
:actor_turkan_khatun a crm:E21_Person ;
    rdfs:label "Turkan Khatun"@en , "ترکان خاتون"@fa ;
    crm:P2_has_type persarch:role_patron .

:ts_ribat_foundation a crm:E52_Time-Span ;
    rdfs:label "508 AH / 1114–1115 CE"@en ;
    crm:P82a_begin_of_the_begin "1114"^^xsd:gYear ;
    crm:P82b_end_of_the_end "1115"^^xsd:gYear .
:ts_ribat_restoration a crm:E52_Time-Span ;
    rdfs:label "549 AH / 1154–1155 CE"@en ;
    crm:P82a_begin_of_the_begin "1154"^^xsd:gYear ;
    crm:P82b_end_of_the_end "1155"^^xsd:gYear .

:evt_ribat_foundation a crm:E12_Production ;
    rdfs:label "Foundation of Ribat-e Sharaf"@en ;
    crm:P4_has_time-span :ts_ribat_foundation ;
    persarch:commissionedBy :actor_sharaf_al_din ;
    persarch:designedBy :actor_katib_ali ;
    crm:P108_has_produced :ribat_sharaf ;
    crm:P126_employed persarch:mat_brick .

:evt_ribat_restoration a crm:E11_Modification ;
    rdfs:label "Restoration after the Ghuzz invasion"@en ;
    crm:P4_has_time-span :ts_ribat_restoration ;
    persarch:commissionedBy :actor_turkan_khatun ;
    crm:P31_has_modified :ribat_sharaf .

#----- 2. Deyr-e Gachin (1668-001 / Q6394061) -----

:deyr_e_gachin a persarch:FourIwanCaravanserai , persarch:Caravanserai ,
        bot:Building , crmba:B1_Built_Work ;
    rdfs:label "Deyr-e Gachin"@en , "دیر گچین"@fa ;
    skos:exactMatch wd:Q6394061 ;
    persarch:unescoComponentId "1668-001" ;
    persarch:isUnescoComponent true ;
    persarch:nationalHeritageNumber "10408" ;
    persarch:province "Qom"@en ;
    crm:P2_has_type persarch:type_caravanserai , persarch:type_four_iwan_plan ,
        persarch:style_sasanian , persarch:style_safavid ;
    crm:P45_consists_of persarch:mat_brick , persarch:mat_stone ;
    geo:asWKT "POINT(51.420136 35.058353)"^^geo:wktLiteral ;
    bot:hasStorey :deyr_ground ;
    bot:containsZone :deyr_sahn ;
    persarch:hasIiifManifest <https://w3id.org/persian-caravanserai-kg/iiif/deyr-e-gachin/manifest.json> ;
    dcterms:description "Often called the mother of Persian caravanserais; Sasanian origin with later Islamic rebuilds, mosque and bath."@en .

:deyr_ground a bot:Storey ;
    bot:hasSpace :deyr_sahn , :deyr_south_iwan , :deyr_mosque , :deyr_bath , :deyr_stables .
:deyr_sahn a persarch:Sahn , bot:Space ;
    rdfs:label "Central courtyard"@en ;
    bot:adjacentZone :deyr_south_iwan , :deyr_mosque , :deyr_stables .
:deyr_south_iwan a persarch:Iwan , bot:Space ;
    rdfs:label "South iwan"@en ;
    bot:adjacentZone :deyr_sahn .
:deyr_mosque a persarch:MosqueSpace , bot:Space ;
    rdfs:label "Mosque"@en ;
    bot:adjacentZone :deyr_sahn .
:deyr_bath a persarch:BathSpace , bot:Space ;
    rdfs:label "Bathhouse"@en .
:deyr_stables a persarch:Stable , bot:Space ;
    rdfs:label "Stables"@en ;
    bot:adjacentZone :deyr_sahn .

:evt_deyr_sasanian a crm:E12_Production ;
    rdfs:label "Sasanian foundation of Deyr-e Gachin"@en ;
    crm:P108_has_produced :deyr_e_gachin ;
    crm:P2_has_type persarch:style_sasanian .

