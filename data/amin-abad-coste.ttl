    dcterms:contributor "Jules Penel" ;
    dcterms:date "1867"^^xsd:gYear ;
    dcterms:identifier "PL. LXVI" ;
    foaf:page <https://commons.wikimedia.org/wiki/File:Amin_Abad_caravanserai_by_Pascal_Coste.jpg> ;
    dcterms:source <https://w3id.org/persian-caravanserai-kg/images/plans/amin_abad.png> ;
    rdfs:seeAlso wd:Q725892 ;
    crm:P70_documents :wd_Q5907540 ;
    rdfs:seeAlso <https://w3id.org/persian-caravanserai-kg/docs/infographics/amin-abad-instances.svg> ;
    rdfs:comment "Plate with vue extérieure, coupe A-B, coupe C-D, and octagonal plan. Graphic scale: 40 m on the plan, 20 m on the coupes. Raster in images/plans/amin_abad.png (4088×5437). Instance SVG fragment ids equal RDF local names (e.g. #wd_Q5907540_hujra_nw_2)."@en .

