# Topology and CIDOC CRM measuring of :wd_Q5959343 (Pasangan / Passencan)
# from Pascal Coste's measured plan in Monuments modernes de la Perse (Morel, 1867).
# Load with data/wikidata-iran-caravanserais.ttl. Do not hand-edit the harvest file.
# Dimensions are estimates from the printed metric scale bars, not UNESCO hectares.
#
# Coste's printed LEGENDE has twelve numbered keys. Keys 1–10 are spaces
# (or a space-plus-element pair at 10); 11–12 are fittings.
# Instance grain: each closed room with a distinct neighbour set is its own
# bot:Space. Coste 7 is sixteen rooms (four per range); Coste 6 is four
# stable ranges. The old IRIs :wd_Q5959343_muleteer_platform and
# :wd_Q5959343_stables are bare bot:Zone series that containsZone the
# instances. Keys 4, 5, 8, 9, 11, 12 remain series until the same census.
# Four corner towers are drawn and unnumbered.
# Scan quality is poor; labels follow the printed legend, not OCR.
# Coste 7 bay index: north and south ranges west→east; east and west
# ranges north→south.

:Reading_Coste_Passencan a prov:Activity ;
    rdfs:label "Reading of Pascal Coste's Passencan plan (legend keys 1–12)"@en ;
    prov:used :coste_1867_passencan ;
    dcterms:source <https://upload.wikimedia.org/wikipedia/commons/3/37/Pasangan_caravanserai_by_Pascal_Coste.jpg> .

:coste_1867_passencan a persarch:PlanImage , crm:E31_Document , crm:E73_Information_Object ;
    rdfs:label "Caravanserail Passencan — Pascal Coste, 1867"@en ;
    rdfs:label "Caravanserail Passencan sur la route de Téhéran à Ispahan"@fr ;
    dcterms:title "Monuments modernes de la Perse mesurés, dessinés et décrits"@fr ;
    dcterms:creator "Pascal Coste" ;
    dcterms:date "1867"^^xsd:gYear ;
    dcterms:identifier "Passencan" ;
    foaf:page <https://commons.wikimedia.org/wiki/File:Pasangan_caravanserai_by_Pascal_Coste.jpg> ;
    dcterms:source <https://upload.wikimedia.org/wikipedia/commons/3/37/Pasangan_caravanserai_by_Pascal_Coste.jpg> ;
    rdfs:seeAlso wd:Q725892 ;
    crm:P70_documents :wd_Q5959343 ;
    rdfs:comment "Plate with vue extérieure, coupe A-B, coupe C-D, and plan. North at the top of the plan; entrance on the south. Graphic scale: 40 m on the plan, 20 m on the coupes."@en .

:wd_Q5959343 a persarch:FourIwanCaravanserai ;
    skos:altLabel "Passencan"@fr , "Passengân"@fr , "Passengan"@fr ;
    crm:P2_has_type persarch:type_four_iwan_plan , persarch:style_safavid ;
    bot:hasStorey :wd_Q5959343_ground , :wd_Q5959343_terrace ;
    bot:containsZone :wd_Q5959343_sahn , :wd_Q5959343_stables , :wd_Q5959343_muleteer_platform ;
    persarch:hasPlanPresentation :coste_1867_passencan ;
    persarch:hasIiifManifest <https://w3id.org/persian-caravanserai-kg/iiif/pasangan/manifest.json> ;
    persarch:hasAttestation :att_coste_passencan ;
    crm:P43_has_dimension :dim_wd_Q5959343_length_ew , :dim_wd_Q5959343_width_ns ,
        :dim_wd_Q5959343_height , :dim_wd_Q5959343_area ;
    dcterms:description "Square four-iwan roadside caravanserai on the Tehran–Isfahan (Qom–Kashan) road. Coste 1867 plan, sections, and exterior view. Entrance faces south."@en .

:att_coste_passencan a persarch:SourceAttestation , crm:E73_Information_Object ;
