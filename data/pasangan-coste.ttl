#################################################################
# CIDOC CRM measuring (E16 / E54) from Coste scale bars
# Commons JPEG 1707×2514. Plan 0–40 m = 750 px → 18.75 px/m.
# Coupes 0–20 m share that graphic length → 37.5 px/m.
# Envelope ±1 m; interiors ±0.5 m. Printed metres, not raw pixels.
#################################################################

:Measurement_Coste_Passencan_scale a crm:E16_Measurement ;
    rdfs:label "Scale-bar measurement of Pasangan from Coste 1867 plate"@en ;
    crm:P39_measured :wd_Q5959343 ;
    crm:P40_observed_dimension :dim_wd_Q5959343_length_ew , :dim_wd_Q5959343_width_ns ,
        :dim_wd_Q5959343_height , :dim_wd_Q5959343_area ,
        :dim_wd_Q5959343_sahn_width , :dim_wd_Q5959343_sahn_area ,
        :dim_wd_Q5959343_porch_diameter ,
        :dim_wd_Q5959343_cistern_side , :dim_wd_Q5959343_cistern_area ,
        :dim_wd_Q5959343_tower_diameter ;
    crm:P2_has_type persarch:method_scale_bar ;
    persarch:locator "échelles: 40 m du plan; 20 m des coupes" ;
    dcterms:source :coste_1867_passencan ;
    rdfs:comment "Pixel run on the Wikimedia scan of Coste's plate. East–west including tower noses is 752 px ≈ 40 m and matches the printed 40 m bar. North–south is 715 px ≈ 38 m; Coste drew a square, so the N–S figure may include scan anamorphism. Height is merlon-to-ground on coupe C–D. Building area is 40 × 38 m, distinct from later 50 × 50 m / 2500 m² site figures."@en ;
    prov:wasGeneratedBy :Reading_Coste_Passencan .

